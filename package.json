{
	"name": "@zim-creator/node-operations",
	"version": "0.0.1",
	"description": "Reusable backend utilities for Node.js and Next.js",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#src/*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./operation": {
			"types": "./dist/Operation.d.ts",
			"import": "./dist/Operation.js"
		},
		"./optional": {
			"types": "./dist/Optional.d.ts",
			"import": "./dist/Optional.js"
		},
		"./pipe": {
			"types": "./dist/Pipe.d.ts",
			"import": "./dist/Pipe.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:fix:unsafe": "biome check --write --unsafe .",
		"ci": "biome ci .",
		"prepack": "yarn build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "26.6.3",
		"@vitest/coverage-v8": "5.0.2",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "yarn@4.18.1"
}
